#!/command/with-contenv bash
# shellcheck shell=bash
# Start the Frigate Extras violation detection worker

set -o errexit -o nounset -o pipefail

# Logs should be sent to stdout so that s6 can collect them

readonly config_file="/opt/frigate/frigate/extras/config.yml"

if [[ ! -f "${config_file}" ]]; then
    echo "[WARN] No extras config at ${config_file}, not starting frigate-extras"
    # Tell S6-Overlay not to restart this service -- without this the missing
    # config would produce a restart loop rather than a single clear message.
    s6-svc -O .
    exec sleep infinity
fi

echo "[INFO] Starting Frigate Extras..."

cd /opt/frigate || echo "[ERROR] Failed to change working directory to /opt/frigate"

# Replace the bash process with the worker, redirecting stderr to stdout.
# Unlike the frigate service this does NOT call `s6-svc -O`: if the worker dies
# we want s6 to restart it, since violation detection failing silently is
# indistinguishable from a quiet period.
exec 2>&1
exec python3 -u -m frigate.extras.main
