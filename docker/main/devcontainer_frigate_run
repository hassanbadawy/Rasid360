#!/command/with-contenv bash
# shellcheck shell=bash
# Start the real Frigate service on the devcontainer.
#
# This used to be a fake loop that only printed a heartbeat, because run-dev.sh
# starts Frigate by hand. The cost was that the UI's Restart button did not
# work: restart_frigate() SIGTERMs pid 1 (s6-svscan), s6 shuts the container
# down, and nothing was supervising Frigate to bring it back -- the app simply
# never returned. Running the real thing here, plus `restart: unless-stopped`
# on the compose service, makes Restart behave as it does in production.
#
# Differs from the production run script only in the working directory: the
# devcontainer runs from the bind-mounted source at /workspace/frigate so edits
# are picked up, rather than the baked image copy at /opt/frigate.

set -o errexit -o nounset -o pipefail

# opt out of openvino telemetry
if [ -e /usr/local/bin/opt_in_out ]; then
  /usr/local/bin/opt_in_out --opt_out > /dev/null 2>&1
fi

# Logs should be sent to stdout so that s6 can collect them

# Tell S6-Overlay not to restart this service. Matches production: when Frigate
# exits, `finish` halts the container and the restart policy brings it back --
# which is what the Restart button is asking for.
s6-svc -O .

function set_libva_version() {
    local ffmpeg_path
    ffmpeg_path=$(python3 /usr/local/ffmpeg/get_ffmpeg_path.py)
    LIBAVFORMAT_VERSION_MAJOR=$("$ffmpeg_path" -version | grep -Po "libavformat\W+\K\d+")
    export LIBAVFORMAT_VERSION_MAJOR
}

echo "[INFO] Preparing Frigate (devcontainer)..."
set_libva_version

echo "[INFO] Starting Frigate from /workspace/frigate..."

cd /workspace/frigate || echo "[ERROR] Failed to change working directory to /workspace/frigate"

# Replace the bash process with the Frigate process, redirecting stderr to stdout
exec 2>&1
exec python3 -u -m frigate
