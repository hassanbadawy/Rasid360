#!/command/with-contenv bash
# shellcheck shell=bash
# Start the Vite dev server on the devcontainer.
#
# Supervised for the same reason frigate and frigate-extras are: the UI's
# Restart button takes the whole container down, and anything started by hand
# does not come back. Without this, pressing Restart left the API up on 5001 and
# the dev frontend on 5173 dead -- a half-working restart, which is worse than
# one that plainly does nothing.
#
# Devcontainer only: production has no /workspace/frigate and serves the built
# assets through nginx.

set -o errexit -o nounset -o pipefail

# Logs should be sent to stdout so that s6 can collect them

readonly web_dir="/workspace/frigate/web"

if [[ ! -d "${web_dir}/node_modules" ]]; then
    echo "[WARN] ${web_dir}/node_modules is missing -- run 'npm install' in ${web_dir}."
    # Tell S6-Overlay not to restart this service: without deps installed it
    # would restart-loop rather than print this once.
    s6-svc -O .
    exec sleep infinity
fi

echo "[INFO] Starting Vite dev server from ${web_dir}..."

cd "${web_dir}" || echo "[ERROR] Failed to change working directory to ${web_dir}"

# Deliberately no `s6-svc -O`: if Vite dies we want it back, and unlike the
# frigate service its exit must never take the container down.
exec 2>&1
exec npm run dev
