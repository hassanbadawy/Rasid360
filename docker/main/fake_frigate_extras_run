#!/command/with-contenv bash
# shellcheck shell=bash
# Start the fake Frigate Extras service

set -o errexit -o nounset -o pipefail

# Tell S6-Overlay not to restart this service
s6-svc -O .

# On the devcontainer the extras worker is started manually by run-dev.sh so it
# can be restarted independently while iterating on rules.
while true; do
  echo "[INFO] The fake Frigate Extras service is running..."
  sleep 5s
done
